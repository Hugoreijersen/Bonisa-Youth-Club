{
  "name": "websites-bonisa",
  "version": "1.0.0",
  "description": "Websites van Stichting Bonisa: jongerenzang.nl (Eleventy)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "db:start": "npx --yes supabase@3.0.0 start",
    "db:stop": "npx --yes supabase@3.0.0 stop",
    "db:reset": "npx --yes supabase@3.0.0 db reset",
    "functies": "npx --yes supabase@3.0.0 functions serve --env-file supabase/functions/.env.local",
    "test:tickets": "node --test supabase/tests/bestellen.test.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
