# Beveiligingsinstellingen voor Cloudflare (gemaakt uit site/_headers.njk).
# Alles komt van de eigen site, behalve het ticketsysteem (Supabase, Frankfurt)
# en de betaalpagina van Mollie. Geen lettertypen, scripts of trackers van anderen.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self' {{ ticketsysteem.herkomst }}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' {{ ticketsysteem.herkomst }} https://www.mollie.com
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Scan page: may use the camera (for the QR codes).
/scan/*
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), interest-cohort=()
  X-Robots-Tag: noindex

/beheer/*
  X-Robots-Tag: noindex

/tickets/mijn/*
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable
