---
layout: base.njk
permalink: /beheer/
titel: Beheer · Katwijkse Jongerenzang
eenvoudigeKop: true
verborgen: true
inlogKop: Beheer tickets
scripts: ["/assets/js/inloggen.js", "/assets/js/beheer.js"]
---
{#- Beheerpagina voor kantoor: cijfers, bestellingen, export, evenement en accounts.
    Uitleg voor kantoor: docs/beheer-tickets.md -#}
<div class="container werkpagina" data-inloggen
     data-functies="{{ ticketsysteem.functiesUrl }}" data-auth="{{ ticketsysteem.authUrl }}"
     data-sleutel="{{ ticketsysteem.publiekeSleutel }}" data-evenement="{{ ticketsysteem.evenement }}">
  {% include "blokken/inlogformulier.njk" %}

  {#- Two-step login for office (besluit 67): code from an authenticator app.
      The first time, the QR code and the key to set the app up are shown. -#}
  <form class="formulier inloggen" data-tweestap hidden>
    <div class="formulier__kop">
      <h1>Code uit je app</h1>
      <p class="tekst-gedempt">Kantoor kan de gegevens van alle kopers zien. Daarom vragen we naast je wachtwoord een code uit een app op je telefoon.</p>
    </div>
    <div class="tweestap" data-tweestap-instellen hidden>
      <ol class="tweestap__stappen">
        <li>Installeer een app voor inlogcodes, bijvoorbeeld Google Authenticator, Microsoft Authenticator of de app Wachtwoorden op een iPhone.</li>
        <li>Scan in die app deze QR-code.</li>
        <li>Vul hieronder de 6 cijfers in die de app toont.</li>
      </ol>
      <img class="tweestap__qr" data-tweestap-qr alt="QR-code om de app in te stellen" width="200" height="200">
      <p class="tekst-gedempt">Lukt scannen niet? Typ dan deze sleutel in de app: <code class="tweestap__geheim" data-tweestap-geheim></code></p>
    </div>
    <p class="melding" data-melding role="alert" hidden></p>
    <div class="veld">
      <label for="tweestap-code">Code (6 cijfers)</label>
      <input id="tweestap-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required>
    </div>
    <button class="knop knop--groen knop--groot" type="submit">Controleren</button>
    <button class="knop knop--klein" type="button" data-uitloggen>Uitloggen</button>
    <p class="tekst-gedempt">Telefoon kwijt of nieuw? Vraag een ander kantooraccount om op deze pagina bij Accounts op "App opnieuw instellen" te klikken.</p>
  </form>

  <div class="beheer" data-app hidden>
    <div class="beheer__balk">
      <p class="bovenkop">Beheer tickets</p>
      <div class="knoppen">
        <button class="knop knop--klein" type="button" data-actie="nieuw-evenement">+ Nieuw evenement</button>
        <button class="knop knop--klein" type="button" data-uitloggen>Uitloggen</button>
      </div>
    </div>

    {#- The selected event: everything below is about this event. -#}
    <section class="evenementpaneel" aria-labelledby="kop-evenementpaneel" data-paneel>
      <div class="evenementpaneel__kies">
        <label class="visueel-verborgen" for="evenement">Kies een evenement</label>
        <select id="evenement" class="evenementpaneel__select" data-evenementen></select>
      </div>
      <h1 id="kop-evenementpaneel" class="evenementpaneel__naam" data-veld="naam"></h1>
      <p class="evenementpaneel__wanneer" data-veld="wanneer"></p>

      <div class="evenementpaneel__bediening">
        <div class="bediening">
          <p class="bediening__label">Ticketverkoop</p>
          <p class="bediening__status"><span class="statuspil" data-veld="verkoop"></span></p>
          <p class="bediening__uitleg" data-veld="verkoop-uitleg"></p>
          <button class="knop knop--klein" type="button" data-actie="verkoop"></button>
        </div>
        <form class="bediening" data-aantalformulier>
          <label class="bediening__label" for="aantal-tickets">Aantal tickets</label>
          <div class="bediening__invoer">
            <input id="aantal-tickets" name="max_tickets" type="number" min="1" required inputmode="numeric">
            <button class="knop knop--klein knop--oranje" type="submit">Opslaan</button>
          </div>
          <div class="voortgang" aria-hidden="true"><span data-veld="voortgang"></span></div>
          <p class="bediening__uitleg" data-veld="verkocht"></p>
        </form>
      </div>
    </section>

    <p class="melding" data-beheer-melding role="alert" hidden></p>
    <p class="bevestiging" data-beheer-bevestiging role="status" hidden></p>

    {#- New event: a separate form, so editing the selected event stays possible. -#}
    <section class="beheer__blok beheer__blok--nieuw" aria-labelledby="kop-nieuw" data-nieuwblok hidden>
      <div class="beheer__blokkop">
        <h2 id="kop-nieuw">Nieuw evenement</h2>
        <button class="knop knop--klein" type="button" data-actie="annuleer-nieuw">Annuleren</button>
      </div>
      <form class="formulier" data-nieuwformulier>
        <div class="velden">
          <div class="veld"><label for="nw-naam">Naam</label><input id="nw-naam" name="naam" required maxlength="120"></div>
          <div class="veld">
            <label for="nw-slug">Vaste naam</label>
            <input id="nw-slug" name="slug" required pattern="[a-z0-9\-]+" maxlength="60" aria-describedby="nw-slug-uitleg">
            <p class="veld__uitleg" id="nw-slug-uitleg">Kleine letters, cijfers en streepjes, bijvoorbeeld jongerenzang-2028. De site zoekt het evenement hiermee op; je kunt hem later niet meer veranderen.</p>
          </div>
          <div class="veld"><label for="nw-begint">Begint op</label><input id="nw-begint" name="begint_op" type="datetime-local" required></div>
          <div class="veld"><label for="nw-locatie">Locatie</label><input id="nw-locatie" name="locatie" required maxlength="120"></div>
          <div class="veld"><label for="nw-prijs">Prijs per ticket (€)</label><input id="nw-prijs" name="prijs" inputmode="decimal" required pattern="\d+([,.]\d{1,2})?"></div>
          <div class="veld"><label for="nw-max">Aantal tickets</label><input id="nw-max" name="max_tickets" type="number" min="1" required></div>
          <div class="veld"><label for="nw-per">Maximaal per bestelling</label><input id="nw-per" name="max_per_bestelling" type="number" min="1" max="50" value="10" required></div>
        </div>
        <p class="tekst-gedempt">De ticketverkoop staat na het aanmaken dicht. Je zet hem open met de knop bovenaan.</p>
        <div><button class="knop knop--groen" type="submit">Evenement aanmaken</button></div>
      </form>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-cijfers" data-heeft-evenement>
      <h2 id="kop-cijfers">Cijfers</h2>
      <dl class="cijfers" data-cijfers></dl>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-bestellingen" data-heeft-evenement>
      <div class="beheer__blokkop">
        <h2 id="kop-bestellingen">Bestellingen</h2>
        <button class="knop knop--zwart knop--klein" type="button" data-actie="export">Exporteer (CSV)</button>
      </div>
      <div class="beheer__filters">
        <div class="veld">
          <label for="zoek">Zoek op naam, e-mail of woonplaats</label>
          <input id="zoek" type="search" data-zoek>
        </div>
        <div class="veld">
          <label for="status">Status</label>
          <select id="status" data-status>
            <option value="">Alle</option>
            <option value="betaald" selected>Betaald</option>
            <option value="open">Open</option>
            <option value="mislukt">Mislukt</option>
            <option value="verlopen">Verlopen</option>
            <option value="terugbetaald">Terugbetaald</option>
          </select>
        </div>
      </div>
      <p class="tekst-gedempt" data-aantal-rijen></p>
      <div class="tabel-scroll" tabindex="0" role="region" aria-label="Bestellingen">
        <table class="tabel">
          <thead><tr><th>Datum</th><th>Naam</th><th>E-mail</th><th>Woonplaats</th><th>Tickets</th><th>Bedrag</th><th>Status</th><th>Ticketmail</th></tr></thead>
          <tbody data-bestellingen></tbody>
        </table>
      </div>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-evenement" data-heeft-evenement>
      <div class="beheer__blokkop">
        <h2 id="kop-evenement">Gegevens van dit evenement</h2>
        <p class="tekst-gedempt">Vaste naam: <code data-veld="slug"></code></p>
      </div>
      <form class="formulier" data-evenementformulier>
        <div class="velden">
          <div class="veld"><label for="ev-naam">Naam</label><input id="ev-naam" name="naam" required maxlength="120"></div>
          <div class="veld"><label for="ev-begint">Begint op</label><input id="ev-begint" name="begint_op" type="datetime-local" required></div>
          <div class="veld"><label for="ev-locatie">Locatie</label><input id="ev-locatie" name="locatie" required maxlength="120"></div>
          <div class="veld">
            <label for="ev-prijs">Prijs per ticket (€)</label>
            <input id="ev-prijs" name="prijs" inputmode="decimal" required pattern="\d+([,.]\d{1,2})?" aria-describedby="ev-prijs-uitleg">
            <p class="veld__uitleg" id="ev-prijs-uitleg">Dit bedrag betalen mensen echt. Zet dezelfde prijs ook in het bewerkscherm van de site.</p>
          </div>
          <div class="veld"><label for="ev-per">Maximaal per bestelling</label><input id="ev-per" name="max_per_bestelling" type="number" min="1" max="50" required></div>
        </div>
        <details class="uitklap">
          <summary>Verkoop automatisch openen of sluiten</summary>
          <p class="tekst-gedempt">Laat leeg als je de verkoop met de knop bovenaan bedient. Zonder sluitmoment sluit de verkoop bij het begin van het evenement.</p>
          <div class="velden">
            <div class="veld"><label for="ev-open">Opent op</label><input id="ev-open" name="verkoop_open_vanaf" type="datetime-local"></div>
            <div class="veld"><label for="ev-dicht">Sluit op</label><input id="ev-dicht" name="verkoop_dicht_op" type="datetime-local"></div>
          </div>
        </details>
        <div><button class="knop knop--groen" type="submit">Wijzigingen opslaan</button></div>
      </form>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-giften">
      <h2 id="kop-giften">Giften (bonisa.nl)</h2>
      <p class="tekst-gedempt">Online giften per project. Giften via de bank vult u per project in bij het bewerkscherm van de site (Pages CMS); die staan hier niet bij.</p>
      <div class="tabel-scroll" tabindex="0" role="region" aria-label="Giften per project">
        <table class="tabel">
          <thead><tr><th>Project</th><th>Opgehaald online</th><th>Giften</th><th>Maandelijkse gevers</th></tr></thead>
          <tbody data-giftenoverzicht></tbody>
        </table>
      </div>
      <form class="formulier" data-giftenexport>
        <h3>Exporteer giften voor de administratie</h3>
        <div class="velden">
          <div class="veld"><label for="gx-van">Van</label><input id="gx-van" name="van" type="date" required></div>
          <div class="veld"><label for="gx-tot">Tot en met</label><input id="gx-tot" name="tot" type="date" required></div>
        </div>
        <div><button class="knop knop--zwart knop--klein" type="submit">Exporteer (CSV)</button></div>
      </form>
      <h3>Maandelijkse giften</h3>
      <div class="tabel-scroll" tabindex="0" role="region" aria-label="Maandelijkse giften">
        <table class="tabel">
          <thead><tr><th>Naam</th><th>E-mail</th><th>Project</th><th>Per maand</th><th>Totaal betaald</th><th>Status</th><th><span class="visueel-verborgen">Actie</span></th></tr></thead>
          <tbody data-maandgiften></tbody>
        </table>
      </div>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-accounts">
      <h2 id="kop-accounts">Accounts</h2>
      <p class="tekst-gedempt">Scanners kunnen alleen de scanpagina gebruiken. Kantoor kan alles op deze pagina. Iemand die via Supabase is uitgenodigd, staat hier met "Geen rol": kies dan Scanner of Kantoor.</p>
      <div class="tabel-scroll" tabindex="0" role="region" aria-label="Accounts">
        <table class="tabel">
          <thead><tr><th>E-mail</th><th>Rol</th><th>Laatst ingelogd</th><th>Code-app</th><th><span class="visueel-verborgen">Actie</span></th></tr></thead>
          <tbody data-accounts></tbody>
        </table>
      </div>
      <form class="formulier" data-accountformulier>
        <h3>Iemand uitnodigen</h3>
        <p class="tekst-gedempt">Diegene krijgt een mail met een link en kiest daar zelf een wachtwoord.</p>
        <div class="velden">
          <div class="veld"><label for="ac-email">E-mailadres</label><input id="ac-email" name="email" type="email" required autocomplete="off"></div>
          <div class="veld">
            <label for="ac-rol">Rol</label>
            <select id="ac-rol" name="rol"><option value="scanner">Scanner</option><option value="kantoor">Kantoor</option></select>
          </div>
        </div>
        <div><button class="knop knop--groen" type="submit">Uitnodiging versturen</button></div>
      </form>
    </section>
  </div>
</div>
