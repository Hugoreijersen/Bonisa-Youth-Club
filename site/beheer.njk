---
layout: base.njk
permalink: /beheer/
titel: Beheer · Katwijkse Jongerenzang
eenvoudigeKop: true
verborgen: true
inlogKop: Beheer tickets
scripts: ["/assets/js/inloggen.js", "/assets/js/beheer.js"]
---
{#- Beheerpagina voor kantoor: cijfers, bestellingen, export, evenement en accounts.
    Uitleg voor kantoor: docs/beheer-tickets.md -#}
<div class="container werkpagina" data-inloggen
     data-functies="{{ ticketsysteem.functiesUrl }}" data-auth="{{ ticketsysteem.authUrl }}"
     data-sleutel="{{ ticketsysteem.publiekeSleutel }}" data-evenement="{{ ticketsysteem.evenement }}">
  {% include "blokken/inlogformulier.njk" %}

  <div class="beheer" data-app hidden>
    <div class="beheer__kop">
      <h1>Beheer tickets</h1>
      <div class="beheer__kies">
        <div class="veld">
          <label for="evenement">Evenement</label>
          <select id="evenement" data-evenementen></select>
        </div>
        <button class="knop knop--klein" type="button" data-uitloggen>Uitloggen</button>
      </div>
    </div>

    <p class="melding" data-beheer-melding role="alert" hidden></p>
    <p class="bevestiging" data-beheer-bevestiging role="status" hidden></p>

    <section class="beheer__blok" aria-labelledby="kop-cijfers">
      <h2 id="kop-cijfers">Cijfers</h2>
      <dl class="cijfers" data-cijfers></dl>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-bestellingen">
      <div class="beheer__blokkop">
        <h2 id="kop-bestellingen">Bestellingen</h2>
        <button class="knop knop--zwart knop--klein" type="button" data-actie="export">Exporteer (CSV)</button>
      </div>
      <div class="beheer__filters">
        <div class="veld">
          <label for="zoek">Zoek op naam, e-mail of woonplaats</label>
          <input id="zoek" type="search" data-zoek>
        </div>
        <div class="veld">
          <label for="status">Status</label>
          <select id="status" data-status>
            <option value="">Alle</option>
            <option value="betaald" selected>Betaald</option>
            <option value="open">Open</option>
            <option value="mislukt">Mislukt</option>
            <option value="verlopen">Verlopen</option>
            <option value="terugbetaald">Terugbetaald</option>
          </select>
        </div>
      </div>
      <p class="tekst-gedempt" data-aantal-rijen></p>
      <div class="tabel-scroll" tabindex="0" role="region" aria-label="Bestellingen">
        <table class="tabel">
          <thead><tr><th>Datum</th><th>Naam</th><th>E-mail</th><th>Woonplaats</th><th>Tickets</th><th>Bedrag</th><th>Status</th><th>Ticketmail</th></tr></thead>
          <tbody data-bestellingen></tbody>
        </table>
      </div>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-evenement">
      <div class="beheer__blokkop">
        <h2 id="kop-evenement">Evenement instellen</h2>
        <button class="knop knop--klein" type="button" data-actie="nieuw-evenement">Nieuw evenement</button>
      </div>
      <p class="tekst-gedempt">De prijs hier is wat mensen echt betalen. Zet dezelfde prijs ook in het bewerkscherm van de site.</p>
      <form class="formulier" data-evenementformulier>
        <div class="velden">
          <div class="veld"><label for="ev-naam">Naam</label><input id="ev-naam" name="naam" required maxlength="120"></div>
          <div class="veld"><label for="ev-slug">Korte naam (in de code, niet te wijzigen)</label><input id="ev-slug" name="slug" required pattern="[a-z0-9\-]+" maxlength="60"></div>
          <div class="veld"><label for="ev-begint">Begint op</label><input id="ev-begint" name="begint_op" type="datetime-local" required></div>
          <div class="veld"><label for="ev-locatie">Locatie</label><input id="ev-locatie" name="locatie" required maxlength="120"></div>
          <div class="veld"><label for="ev-prijs">Prijs per ticket (€)</label><input id="ev-prijs" name="prijs" inputmode="decimal" required pattern="\d+([,.]\d{1,2})?"></div>
          <div class="veld"><label for="ev-max">Aantal tickets in totaal</label><input id="ev-max" name="max_tickets" type="number" min="1" required></div>
          <div class="veld"><label for="ev-per">Maximaal per bestelling</label><input id="ev-per" name="max_per_bestelling" type="number" min="1" max="50" required></div>
          <div class="veld"><label for="ev-open">Verkoop open vanaf (leeg = dicht)</label><input id="ev-open" name="verkoop_open_vanaf" type="datetime-local"></div>
          <div class="veld"><label for="ev-dicht">Verkoop dicht op (leeg = bij het begin)</label><input id="ev-dicht" name="verkoop_dicht_op" type="datetime-local"></div>
        </div>
        <button class="knop knop--groen knop--klein" type="submit">Opslaan</button>
      </form>
    </section>

    <section class="beheer__blok" aria-labelledby="kop-accounts">
      <h2 id="kop-accounts">Accounts</h2>
      <p class="tekst-gedempt">Scanners kunnen alleen de scanpagina gebruiken. Kantoor kan alles op deze pagina.</p>
      <div class="tabel-scroll" tabindex="0" role="region" aria-label="Accounts">
        <table class="tabel">
          <thead><tr><th>E-mail</th><th>Rol</th><th>Laatst ingelogd</th><th><span class="visueel-verborgen">Actie</span></th></tr></thead>
          <tbody data-accounts></tbody>
        </table>
      </div>
      <form class="formulier" data-accountformulier>
        <h3>Account toevoegen</h3>
        <div class="velden">
          <div class="veld"><label for="ac-email">E-mailadres</label><input id="ac-email" name="email" type="email" required autocomplete="off"></div>
          <div class="veld"><label for="ac-wachtwoord">Wachtwoord (minstens 10 tekens)</label><input id="ac-wachtwoord" name="wachtwoord" type="text" minlength="10" autocomplete="new-password"></div>
          <div class="veld">
            <label for="ac-rol">Rol</label>
            <select id="ac-rol" name="rol"><option value="scanner">Scanner</option><option value="kantoor">Kantoor</option></select>
          </div>
        </div>
        <button class="knop knop--groen knop--klein" type="submit">Toevoegen</button>
      </form>
    </section>
  </div>
</div>
