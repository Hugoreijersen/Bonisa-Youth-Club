// Cloudflare Workers: serves the built site (_site/) as static files.
// No Worker code runs: there is no "main". Personal data never passes through
// Cloudflare (besluit 17); the ticket system runs at Supabase in Frankfurt.
// Explanation in Dutch: docs/hoe-de-site-werkt.md
{
  "name": "bonisa-youth-club",
  "compatibility_date": "2026-11-01",
  // Builds the site before every deploy, also when the Cloudflare dashboard
  // has no build command set.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
