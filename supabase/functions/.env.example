# Copy to supabase/functions/.env.local for local development (that file is
# in .gitignore). Online these values are set as Supabase secrets, see
# docs/ticketsysteem.md. Never put a real (live_) Mollie key in a file.
SITE_URL=http://localhost:8080
SITE_ORIGINS=http://localhost:8080
MOLLIE_API_KEY=test_nepsleutel
# Fake Mollie for tests (npm run test:tickets starts it on port 54399).
# Remove this line to use the real Mollie test environment.
MOLLIE_API_URL=http://host.docker.internal:54399/v2
# Public address of the functions, used to build the Mollie webhook address.
# Locally Mollie cannot reach it; the thank-you page then checks the status.
PUBLIC_FUNCTIONS_URL=https://voorbeeld.supabase.co/functions/v1
