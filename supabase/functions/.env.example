# Copy to supabase/functions/.env.local for local development (that file is
# in .gitignore). Online these values are set as Supabase secrets, see
# docs/ticketsysteem.md. Never put a real (live_) Mollie key in a file.
SITE_URL=http://localhost:8080
SITE_ORIGINS=http://localhost:8080
MOLLIE_API_KEY=test_nepsleutel
# Fake Mollie, MailerSend and MailerLite (npm run nep, port 54399; the tests
# start it themselves).
# Remove this line to use the real Mollie test environment.
MOLLIE_API_URL=http://host.docker.internal:54399/v2
# Public address of the functions, used to build the Mollie webhook address.
# Locally Mollie cannot reach it; the thank-you page then checks the status.
PUBLIC_FUNCTIONS_URL=https://voorbeeld.supabase.co/functions/v1
# Ticket mail (MailerSend). Online: an API key and a verified sender domain.
MAIL_API_KEY=nep
MAIL_API_URL=http://host.docker.internal:54399/v1
MAIL_FROM=tickets@jongerenzang.nl
MAIL_FROM_NAAM=Katwijkse Jongerenzang
MAIL_REPLY_TO=
# Newsletter (MailerLite). Leave the key empty to switch the sign-up off.
MAILERLITE_API_KEY=nep
MAILERLITE_API_URL=http://host.docker.internal:54399/api
MAILERLITE_GROEP=
# Gifts for bonisa.nl (docs/giften.md). Own Mollie website profile, so its
# own key. Locally the fake Mollie accepts any key that starts with test_.
MOLLIE_GIFTEN_API_KEY=test_nepsleutel_giften
GIFTEN_SITE_URL=http://localhost:8080
# Published project list. Online leave empty: then GIFTEN_SITE_URL/geven/projecten.json.
PROJECTEN_URL=http://host.docker.internal:54399/geven/projecten.json
GIFTEN_MAIL_FROM=giften@bonisa.nl
GIFTEN_MAIL_FROM_NAAM=Stichting Bonisa
GIFTEN_MAIL_REPLY_TO=
